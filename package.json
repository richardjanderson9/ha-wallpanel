{
  "name": "ha-wallpanel",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A responsive Home Assistant wall panel interface built with React, Vite, and Tailwind CSS. Designed to run locally inside a Docker container for high-performance dashboard control.",
  "author": {
    "name": "Richard Anderson",
    "linkedin": "https://www.linkedin.com/in/richardjanderson9/"
  },
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write src/**/*.{jsx,css,json,md}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richardjanderson9/ha-wallpanel/"
  },
  "bugs": {
    "url": "https://github.com/richardjanderson9/ha-wallpanel/issues"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "postcss": "^8.4.31"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}